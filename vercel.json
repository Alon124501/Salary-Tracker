{
  "version": 2,
  "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/monthly-receipts",      "schedule": "0 2 1 * *" },
    { "path": "/api/cron/process-notifications", "schedule": "0 8 * * *" }
  ]
}
